#: Modules/Queues.php:16
msgid "Queues Info"
msgstr "Información de Colas"

#: Modules/Registries.php:12
msgid "Registries"
msgstr "Registros"

#: Modules/Registries.php:46
msgid ""
"Drivers (ChanSIP or PJSIP or IAX) are not loaded into asterisk, hence no "
"registration information to display."
msgstr ""
"Los controladores (ChanSIP o PJSIP o IAX) no se cargan en asterisk, por lo "
"tanto no hay información de registro para mostrar."

#: Modules/Subscriptions.php:12
msgid "Subscriptions"
msgstr "Suscripciones"

#: Modules/Subscriptions.php:16
msgid "Subscribe/Notify"
msgstr "Suscribir/Notificar"

#: Modules/Voicemail.php:12
msgid "Voicemail"
msgstr "Mensaje de voz"

#: Modules/Voicemail.php:16
msgid "Voicemail Users"
msgstr "Usuarios del buzón de voz"

#: Modules/Voicemail.php:52
msgid "Dialplan Context"
msgstr "Contexto de Dialplan"

#: Modules/Voicemail.php:55
msgid ""
"Logical call context to which the voicemail box belongs. Typically “default” "
"if no advanced configuration is used."
msgstr ""
"Contexto lógico de llamada al que pertenece el buzón de voz. Normalmente "
"\"predeterminado\" si no se utiliza ninguna configuración avanzada."

#: Modules/Voicemail.php:58
msgid "Mailbox Number"
msgstr "Número de Buzón"

#: Modules/Voicemail.php:61
msgid "The mailbox number, which is usually the same as the user ID."
msgstr "El número de buzón, que suele coincidir con el ID de usuario."

#: Modules/Voicemail.php:64
msgid "User ID"
msgstr "ID de Usuario"

#: Modules/Voicemail.php:67
msgid ""
"The user ID associated with the voicemail box, often the same as the mailbox "
"number."
msgstr ""
"El ID de usuario asociado al buzón de voz, a menudo el mismo que el número "
"de buzón."

#: Modules/Voicemail.php:70
msgid "Time Zone"
msgstr "Zona Horaria"

#: Modules/Voicemail.php:73
msgid ""
"Time zone used for voicemail message timestamps. If empty, the system "
"default time zone is used."
msgstr ""
"Zona horaria utilizada para las marcas de tiempo de los mensajes del buzón "
"de voz. Si está vacía, se utiliza la zona horaria predeterminada del sistema."

#: Modules/Voicemail.php:76
msgid "New Voicemail Count"
msgstr ""

#: Modules/Voicemail.php:80
msgid "The number of new voicemails in the mailbox."
msgstr "El número de nuevos mensajes de voz en el buzón."

#: Modules/Voicemail.php:87
msgid "New Messages"
msgstr "Mensajes nuevos"

#: Modules/Voicemail.php:92
msgid "With New Messages"
msgstr "Con nuevos mensajes"

#: Modules/Voicemail.php:102
msgid "Without New Messages"
msgstr "Sin mensajes nuevos"

